From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Devin <devin@cognition.ai>
Date: Mon, 20 Oct 2026 00:00:00 +0000
Subject: [PATCH] ci: add dependency-vulnerability gate to validate job

Apply on main (requires `workflow` scope on the pushing token):
  git apply docs/patches/security-ci-npm-audit.patch
  git commit -m "ci: add npm audit gate to validate job" && git push

---
 .github/workflows/security-ci.yml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/.github/workflows/security-ci.yml b/.github/workflows/security-ci.yml
index 0000000..0000000 100644
--- a/.github/workflows/security-ci.yml
+++ b/.github/workflows/security-ci.yml
@@ -21,3 +21,5 @@ jobs:
         run: npx tsx --test tests/*.test.ts
       - name: Build
         run: npm run build
+      - name: Dependency vulnerabilities
+        run: npm audit --audit-level=high
