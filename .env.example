PORT=3000
DATABASE_PATH=flussonic.db
NODE_ENV=development

# SSL Configuration (optional)
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# Telegram bot webhook: set the same value as `secret_token` when calling setWebhook.
# The webhook endpoint rejects all requests while this is unset.
# TELEGRAM_WEBHOOK_SECRET=
