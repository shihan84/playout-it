# Copy to .env and fill in. Every setting the app reads is listed here; commented lines show the default.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=flussonic.db
# Interface to listen on. Defaults: 127.0.0.1 in development, 0.0.0.0 in production.
# BIND_HOST=127.0.0.1
# Required in production: random, at least 32 characters (openssl rand -hex 32).
# Changing it logs everyone out.
# JWT_SECRET=

# Number of reverse-proxy hops in front of the app (e.g. 1 behind a single nginx).
# Leave unset when clients connect directly; never set it higher than the real hop count.
# TRUST_PROXY=1

# --- HTTPS served by the app itself (optional; usually nginx terminates TLS) ---
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# --- Login rate limit (per client IP) ---
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=30

# --- Uploads ---
# UPLOAD_MAX_GB=50

# --- Telegram ---
# Bot token for per-stream subscriber alerts (Telegram Alerts page); they are skipped while unset.
# General notifications use the bot token saved in Settings instead.
# TELEGRAM_BOT_TOKEN=
# Bot webhook: set the same value as `secret_token` when calling setWebhook.
# The webhook endpoint rejects all requests while this is unset.
# TELEGRAM_WEBHOOK_SECRET=

# --- Scheduled database backups (online SQLite backup, verified, oldest pruned) ---
# Default folder: "backups" next to DATABASE_PATH. Set BACKUP_INTERVAL_HOURS=0 to disable.
# Check a backup restores cleanly with: npm run db:restore-drill
# BACKUP_DIR=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# --- Logging ---
# Set to "json" for one JSON object per log line (journald, log shippers). Default: plain text.
# LOG_FORMAT=json

# --- Playout scheduler (off unless set to 1) ---
# SCHEDULER_ENABLED=1
# SCHEDULER_TICK_MS=30000

# --- Overlay workers (ffmpeg; off unless set to 1) ---
# OVERLAY_ENABLED=1
# OVERLAY_AUTO_RESTART_ENABLED=1
# OVERLAY_MAX_WORKERS=8
# OVERLAY_ASSET_DIR=assets/overlay
# OVERLAY_RESTART_MAX_ATTEMPTS=5
# OVERLAY_RESTART_BASE_DELAY_MS=5000
# OVERLAY_RESTART_MAX_DELAY_MS=300000
# OVERLAY_RESTART_STABLE_MS=60000
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Admin provisioning (npm run admin:provision only; not read by the server) ---
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD_FILE=
