PORT=3000
DATABASE_PATH=flussonic.db
NODE_ENV=development

# SSL Configuration (optional)
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=
# Interface to listen on. Defaults: 127.0.0.1 in development, 0.0.0.0 in production.
# BIND_HOST=127.0.0.1

# Telegram bot webhook: set the same value as `secret_token` when calling setWebhook.
# The webhook endpoint rejects all requests while this is unset.
# TELEGRAM_WEBHOOK_SECRET=

# Number of reverse-proxy hops in front of the app (e.g. 1 behind a single nginx).
# Leave unset when clients connect directly; never set it higher than the real hop count.
# TRUST_PROXY=1
